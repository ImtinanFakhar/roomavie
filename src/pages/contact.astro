---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL || 'hello@roomavie.com';
---
<Layout title="Contact Roomavie | Say Hello" description="Have a home decor question, an idea to share, or a collaboration in mind? Get in touch with Roomavie.">
  <section class="page-heading content-width"><span class="eyebrow">We’d love to hear from you</span><h1>Let’s make a little connection.</h1><p>A question, a favorite home idea, or just a friendly hello — our inbox is open.</p></section>
  <section class="contact-page content-width"><div class="contact-card"><Icon name="mail" size={32} /><h2>Say hello.</h2><p>For questions, feedback, and collaboration ideas, drop us a note. Tell us a little about what’s on your mind.</p><a class="contact-email" href={`mailto:${email}`}>{email} <Icon name="arrow" size={21} /></a></div><div class="contact-details"><span class="eyebrow">A thoughtful note goes a long way</span><h2>What are you dreaming of?</h2><p>Looking for inspiration for a tricky corner? Have a beautiful space to share? We always enjoy hearing what makes a house feel like home.</p><p>For a collaboration, include a little about your project and any relevant links so we can get to know it.</p><a class="text-link" href="/blog/">Explore the latest ideas <Icon name="arrow" size={18} /></a></div></section>
</Layout>
